---
import '../styles/global.css';
import GameDashboard from '../components/GameDashboard.jsx';
import InspectGuard from '../components/InspectGuard.astro';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#F8F6F1" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Public+Sans:wght@400;500;600;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Public+Sans:wght@400;500;600;700&display=swap"
      />
    </noscript>
    <title>Perayaan 1 Dekade TL 2016 - Portal Sedulur 16</title>
  </head>
  <body class="bg-[#F8F6F1] text-zinc-900 m-0 p-0 min-h-screen">
    <InspectGuard />
    <GameDashboard client:only="react" />
  </body>
</html>
