---
import '../styles/global.css';
import UpdatesPage from '../components/UpdatesPage.jsx';
import InspectGuard from '../components/InspectGuard.astro';
---
<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="only light" />
    <meta name="theme-color" content="#FAF6EE" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fredoka:wght@600;700&family=JetBrains+Mono:wght@500;700&display=swap"
      />
    </noscript>
    <title>Catatan Update &amp; Dokumentasi - 1 Dekade TL 2016</title>
  </head>
  <body class="bg-[#FAF6EE] text-stone-900 m-0 p-0 min-h-screen">
    <InspectGuard />
    <UpdatesPage client:load />
  </body>
</html>
