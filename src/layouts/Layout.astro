---
import '../styles/global.css';
import InspectGuard from '../components/InspectGuard.astro';
const { title = 'Perayaan 1 Dekade Teknik Lingkungan 2016 (Sedulur 16)' } = Astro.props;
---
<!doctype html>
<html lang="id">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="only light" />
		<meta name="theme-color" content="#F8F6F1" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Public+Sans:wght@400;500;600;700&display=swap"
			media="print"
			onload="this.media='all'"
		/>
		<noscript>
			<link
				rel="stylesheet"
				href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700;800&family=JetBrains+Mono:wght@500;700&family=Public+Sans:wght@400;500;600;700&display=swap"
			/>
		</noscript>
		<title>{title}</title>
	</head>
	<body class="bg-[#F8F6F1] text-zinc-900 m-0 p-0 min-h-screen">
		<InspectGuard />
		<slot />
	</body>
</html>
